diff --git a/src/styles.scss b/src/styles.scss
new file mode 100644
index 0000000..5a3e590
--- /dev/null
+++ b/src/styles.scss
@@ -0,0 +1,493 @@
+/* =============================================================
+   FTN — Fédération Tunisienne de Natation  |  Global Styles
+   ============================================================= */
+
+/* ── 0. CSS variable bridge (PrimeNG @primeuix/themes → layout CSS) ── */
+:root {
+    --layout-topbar-height: 4rem;
+    --layout-sidebar-width: 17rem;
+    --layout-transition: 0.2s;
+
+    --surface-ground:     var(--p-surface-50,  #f8fafc);
+    --surface-card:       var(--p-surface-0,   #ffffff);
+    --surface-border:     var(--p-surface-200, #e2e8f0);
+    --surface-hover:      var(--p-surface-100, #f1f5f9);
+    --text-color:         var(--p-surface-700, #334155);
+    --text-color-secondary: var(--p-surface-500, #64748b);
+    --primary-color:      var(--p-primary-500, #3b82f6);
+    --primary-color-text: #ffffff;
+    --primary-50:         var(--p-primary-50,  #eff6ff);
+    --primary-600:        var(--p-primary-600, #2563eb);
+    --highlight-bg:       rgba(59, 130, 246, 0.08);
+}
+
+/* dark mode */
+.app-dark {
+    --surface-ground:     var(--p-surface-900, #0f172a);
+    --surface-card:       var(--p-surface-800, #1e293b);
+    --surface-border:     var(--p-surface-700, #334155);
+    --surface-hover:      var(--p-surface-700, #334155);
+    --text-color:         var(--p-surface-100, #f1f5f9);
+    --text-color-secondary: var(--p-surface-400, #94a3b8);
+    --primary-50:         rgba(59, 130, 246, 0.12);
+    --highlight-bg:       rgba(59, 130, 246, 0.15);
+}
+
+/* ── 1. Base ── */
+*,
+*::before,
+*::after { box-sizing: border-box; }
+
+html, body {
+    margin: 0;
+    padding: 0;
+    min-height: 100vh;
+    font-family: var(--p-font-family, ui-sans-serif, system-ui, -apple-system, sans-serif);
+    font-size: 14px;
+    color: var(--text-color);
+    background: var(--surface-ground);
+    -webkit-font-smoothing: antialiased;
+}
+
+body.blocked-scroll { overflow: hidden; }
+
+a { color: var(--primary-color); text-decoration: none; }
+a:hover { text-decoration: underline; }
+
+/* ── 2. Topbar ── */
+.layout-topbar {
+    position: fixed;
+    top: 0; left: 0; right: 0;
+    height: var(--layout-topbar-height);
+    z-index: 997;
+    display: flex;
+    align-items: center;
+    padding: 0 1.5rem;
+    gap: 0.75rem;
+    background: var(--surface-card);
+    border-bottom: 1px solid var(--surface-border);
+    box-shadow: 0 1px 4px rgba(0,0,0,.06);
+}
+
+.layout-topbar-logo-container {
+    display: flex;
+    align-items: center;
+    gap: 0.75rem;
+    min-width: var(--layout-sidebar-width);
+    margin-left: -1.5rem;
+    padding-left: 1.5rem;
+}
+
+.layout-topbar-logo {
+    display: flex;
+    align-items: center;
+    gap: 0.5rem;
+    font-size: 1.2rem;
+    font-weight: 700;
+    color: var(--text-color);
+    text-decoration: none;
+
+    svg { width: 2rem; height: auto; }
+    span { color: var(--text-color); }
+}
+
+.layout-menu-button,
+.layout-topbar-action,
+.layout-topbar-menu-button {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    width: 2.5rem;
+    height: 2.5rem;
+    border: 0 none;
+    border-radius: 50%;
+    background: transparent;
+    color: var(--text-color-secondary);
+    cursor: pointer;
+    transition: background var(--layout-transition), color var(--layout-transition);
+
+    i { font-size: 1.1rem; }
+    span { display: none; }
+
+    &:hover {
+        background: var(--surface-hover);
+        color: var(--primary-color);
+    }
+}
+
+.layout-topbar-action-highlight {
+    background: var(--primary-color);
+    color: var(--primary-color-text) !important;
+
+    &:hover { background: var(--primary-600); }
+}
+
+.layout-topbar-actions {
+    display: flex;
+    align-items: center;
+    gap: 0.5rem;
+    margin-left: auto;
+}
+
+.layout-config-menu {
+    display: flex;
+    align-items: center;
+    gap: 0.5rem;
+    position: relative;
+}
+
+.layout-topbar-menu-button { display: none; }
+
+.layout-topbar-menu {
+    .layout-topbar-menu-content {
+        display: flex;
+        align-items: center;
+        gap: 0.5rem;
+    }
+
+    &.hidden { display: none !important; }
+}
+
+/* ── 3. Sidebar ── */
+.layout-sidebar {
+    position: fixed;
+    top: var(--layout-topbar-height);
+    left: 0;
+    width: var(--layout-sidebar-width);
+    height: calc(100vh - var(--layout-topbar-height));
+    z-index: 998;
+    overflow-y: auto;
+    overflow-x: hidden;
+    background: var(--surface-card);
+    border-right: 1px solid var(--surface-border);
+    transform: translateX(0);
+    transition: transform var(--layout-transition);
+
+    &::-webkit-scrollbar { width: 4px; }
+    &::-webkit-scrollbar-thumb {
+        background: var(--surface-border);
+        border-radius: 2px;
+    }
+}
+
+/* ── 4. Main content ── */
+.layout-main-container {
